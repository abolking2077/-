{
  "manifest_version": 3,
  "name": "Almas 7 | الماس ۷",
  "short_name": "Almas 7",
  "version": "1.2.0",
  "description": "الماس ۷ - داشبورد شخصی‌سازی شده و مدیریت پیشرفته بوکمارک‌ها با طرح مدرن، تم‌های دارک، لایت و لیکویید گلس",
  "permissions": [
    "bookmarks",
    "storage",
    "notifications"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Almas 7 | الماس ۷"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
